OPENAI_API_KEY=sk-...

# Zendesk Help Center that gets scraped
HELP_CENTER_URL=https://support.optisigns.com
HELP_CENTER_LOCALE=en-us
MIN_ARTICLES=30

# Local paths (defaults shown)
ARTICLES_DIR=articles
STATE_PATH=state.json

# Leave VECTOR_STORE_ID empty on the first run; the job creates a store and
# logs its id -- pin that id here afterwards so every run reuses it instead
# of creating a new store each day.
VECTOR_STORE_NAME=optibot-knowledge-base
VECTOR_STORE_ID=
