# Which backend to use -- "openai" or "gemini". Switching providers means a
# fresh store (see below); the two are not interchangeable mid-stream.
AI_PROVIDER=openai

# Needed only when AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Needed only when AI_PROVIDER=gemini. Get a free key with no payment method
# required at aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# Zendesk Help Center that gets scraped
HELP_CENTER_URL=https://support.optisigns.com
HELP_CENTER_LOCALE=en-us
# Assignment floor is >=30; default pulls every article there is (~412) so a
# real user question isn't missed just because its article fell past a
# partial-crawl cutoff. Lower this only to shrink a demo/test run on purpose.
MIN_ARTICLES=1000

# Local paths (defaults shown)
ARTICLES_DIR=articles
STATE_PATH=state.json

# Leave *_STORE_ID empty on the first run; the job creates a store and logs
# its id -- pin that id here afterwards so every run reuses it instead of
# creating a new store each day. Only the id matching AI_PROVIDER is read.
STORE_NAME=optibot-knowledge-base
VECTOR_STORE_ID=
GEMINI_STORE_ID=
